// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  phoneNumber   String?  @map("phone_number")
  emailVerified Boolean  @default(false) @map("email_verified")
  isAdmin       Boolean  @default(false) @map("is_admin")
  createdAt     DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("users")
}

model VerificationCode {
  email     String   @id
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")

  @@map("verification_codes")
}

model RefreshToken {
  tokenId   String   @id @map("token_id") @db.Char(36)
  userId    Int      @map("user_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String  @default("product")
  dimentions  String  @default("0x0")
  price       Decimal @db.Decimal(10, 2)
  photoUrl    String  @map("photo-url")
  status      String  @default("available") // ← nou: "available" | "sold"
  viewEnabled Boolean @default(true) @map("view_enabled") //

  photos     ProductPhoto[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductPhoto {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  url       String
  position  Int // 0 = preview, restul = galerie

  product Product @relation(fields: [productId], references: [id])

  @@map("product_photos")
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  status      String   @default("pending")
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  lastUpdate  DateTime @default(now()) @map("last_updated")

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2) // preț "înghețat" la momentul comenzii

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Exhibitions {
  id          Int      @id @default(autoincrement())
  title       String   @map("exhibition_title")
  date        DateTime @map("exhibition_date")
  location    String   @map("exhibition_location")
  description String   @map("exhibition_description") @db.Text
  status      String   @map("exhibition_status") //ongoing, upcoming/past
  viewEnabled Boolean  @map("view_enabled")

  @@map("exhibitions")
}
